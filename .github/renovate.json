{
    "extends": ["github>todoist/renovate-config:frontend-base"],
    "packageRules": [
        {
            "groupName": "tiptap packages",
            "automerge": false,
            "matchPackageNames": ["/^@tiptap//"]
        },
        {
            "groupName": "gfm autolink literal packages",
            "matchPackageNames": ["/gfm-autolink-literal$/"]
        },
        {
            "groupName": "gfm strikethrough packages",
            "matchPackageNames": ["/gfm-strikethrough$/"]
        },
        {
            "description": "Keep tsdown compatible with TypeScript 7.0 until compatibility is restored or TypeScript 7.1 is stable.",
            "matchPackageNames": ["tsdown"],
            "allowedVersions": "<=0.23.1"
        },
        {
            "description": "Keep devEngines.runtime as a minimum Node.js version instead of pinning it.",
            "matchDepTypes": ["devEngines.runtime"],
            "rangeStrategy": "auto"
        },
        {
            "matchPackageNames": ["/eslint/"],
            "enabled": false
        }
    ]
}
